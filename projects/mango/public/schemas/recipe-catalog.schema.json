    "recipe_status": {
      "enum": [
        "draft",
        "published",
        "archived",
        "normalized",
        "review_pending"
      ]
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "normalized",
        "normalized_with_inference",
        "verified",
        "rejected",
        "needs_human_review",
        "normalized_from_source"
      ]
    },
    "classification_status": {
      "enum": [
        "unreviewed",
        "estimated",
        "source_verified_with_inference",
        "verified"
      ]
    },
    "calorie_basis": {
      "enum": [
        "source",
        "nutrition_label",
        "calculated",
        "estimated",
        "unknown",
        "not_available",
        "unavailable"
      ]
    },
    "temperature_unit": {
      "enum": [
        "C",
        "F"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "catalog_type",
        "name_i18n",
        "description",
        "image_url",
        "default_cuisines",
        "source_directory",
        "record_count"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/catalog_code"
        },
        "catalog_type": {
          "$ref": "#/$defs/catalog_type"
        },
        "name_i18n": {
          "$ref": "#/$defs/name_i18n"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "URL ảnh đại diện catalog. Không dùng absolute filesystem path hoặc URL giả."
        },
        "default_cuisines": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cuisine_code"
          }
        },
        "source_directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\).+",
          "description": "Đường dẫn tương đối tới thư mục nguồn; không được là absolute path."
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "image_search_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "image_alt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "catalog_type": {
                "const": "collection"
              }
            },
            "required": [
              "catalog_type"
            ]
          },
          "then": {
            "properties": {
              "default_cuisines": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "catalog_type": {
                "const": "cuisine"
              }
            },
            "required": [
              "catalog_type"
            ]
          },
          "then": {
            "properties": {
              "default_cuisines": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "source_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "author",
        "publisher",
        "year"
      ],
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2100
        }
      }
    },
    "temperature": {
      "description": "Nhiệt độ có thể là cấu trúc value/unit hoặc chuỗi hướng dẫn legacy khi bước cần nhiều mốc nhiệt.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "anyOf": [
                {
                  "$ref": "#/$defs/temperature_unit"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "is_optional"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "canonical_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "is_optional": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "raw_text",
        "quantity",
        "unit",
        "sort_order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "Tên nguyên liệu. Dữ liệu mới nên không rỗng; schema vẫn đọc một số bản ghi legacy OCR có chuỗi rỗng và lint sẽ cảnh báo."
        },
        "canonical_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "quantity_min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "quantity_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "quantity_per_serving": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/unit"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_normalized": {
          "anyOf": [
            {
              "$ref": "#/$defs/unit_normalized"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_amount": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_optional": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 1
        },
        "macro_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/macro_class"
            },
            {
              "type": "null"
            }
          ]
        },
        "allergen_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allergen_flag"
          }
        },
        "flavor_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flavor_tag"
          }
        },
        "culinary_roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/culinary_role"
          }
        },
        "prep_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "cut_style": {
          "type": [
            "string",
            "null"
          ]
        },
        "marinade_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "quantity_is_estimate": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Đánh dấu định lượng là ước lượng."
        },
        "name_i18n": {
          "anyOf": [
            {
              "$ref": "#/$defs/name_i18n"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
