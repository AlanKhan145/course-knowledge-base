{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mango.app/schemas/recipe-catalog.schema.json",
  "title": "Mango Recipe Catalog",
  "description": "Schema catalog công thức Mango, đồng bộ với 22 catalog dữ liệu hiện tại và vocabularies 1.1.0. Bổ sung coverage cho enum thực tế, image_search_url, quantity_is_estimate và metadata dinh dưỡng ở cấp nguyên liệu. Schema ưu tiên tương thích với dữ liệu catalog hiện tại; các quy tắc chất lượng như không trùng enum, đủ phase và không để null trong text array được kiểm tra ở lint/report thay vì làm schema từ chối toàn file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog",
    "recipe_template",
    "recipes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Đường dẫn tương đối tới file schema này."
    },
    "schema_version": {
      "const": "1.0.0",
      "description": "Phiên bản schema của file catalog."
    },
    "catalog": {
      "$ref": "#/$defs/catalog"
    },
    "recipe_template": {
      "$ref": "#/$defs/recipe_template",
      "description": "Bản ghi rỗng khai báo đầy đủ trường. Không phải món thật, không tính vào record_count."
    },
    "recipes": {
      "type": "array",
      "description": "Các món thật đã chuẩn hoá. Số phần tử phải bằng catalog.record_count; ràng buộc chéo này được kiểm tra bằng script.",
      "items": {
        "$ref": "#/$defs/recipe"
      }
    }
  },
  "$defs": {
    "name_i18n": {
      "type": "object",
      "description": "Đối tượng đa ngữ. Bắt buộc có vi; cho phép bổ sung ngôn ngữ khác như en.",
      "required": [
        "vi"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalog_type": {
      "enum": [
        "cuisine",
        "collection"
      ],
      "description": "cuisine = catalog gắn với một nền ẩm thực; collection = catalog theo chủ đề."
    },
